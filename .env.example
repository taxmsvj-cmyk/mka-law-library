# نمونه متغیرهای محیطی — این فایل را کپی کنید به `.env` و مقادیر واقعی را بگذارید.
# فایل `.env` هرگز نباید در مخزن ذخیره شود (در .gitignore قرار دارد).

# --- سمت سرور (فقط در سرور خوانده می‌شود) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_PROJECT_ID=<project-ref>

# --- سمت مرورگر (در باندل فرانت‌اند قرار می‌گیرد؛ فقط کلید عمومی) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- اختیاری: فقط برای کارهای مدیریتی سمت سرور ---
# این کلید RLS را دور می‌زند؛ هرگز آن را در کد سمت مرورگر استفاده نکنید.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- مخزن اسناد Google Drive (منبع اصلی داده‌ی کتابخانه) ---
# ریشه‌ی مخزن؛ اگر خالی باشد شناسه‌ی پوشه‌ی رسمی سازمان استفاده می‌شود.
# GDRIVE_ROOT_FOLDER_ID=1Jx0cipUqQyGnJk4hFCURzWIg1Abo1Del
# اختیاری ولی توصیه‌شده: کلید API گوگل با دسترسی Google Drive API
# (Google Cloud Console → APIs & Services → Credentials → API key؛
#  محدود به Google Drive API). بدون این کلید از نمای عمومی پوشه استفاده می‌شود.
# GOOGLE_DRIVE_API_KEY=<google-api-key>

# --- سیاست منابع رسمی (پیش‌فرض: بسته) ---
# به هیچ عنوان پیش از مشورت با مالک پروژه و دریافت اجازه‌ی کتبی true نکنید.
# فقط با اجازه‌ی مالک: واکشی خودکار از tax.gov.ir و rc.majlis.ir و ... فعال می‌شود.
# OFFICIAL_FALLBACK_APPROVED=false
